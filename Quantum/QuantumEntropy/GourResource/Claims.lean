Metadata: {"id": "Y10", "fqn": "GourResource.gsl_y10", "source": {"gour": {"ref": "Thm 11.4", "url": "https://arxiv.org/pdf/2402.05474v2#nameddest=theorem.11.4", "page": 504}, "hy": [{"ref": "Lemma 6", "url": "https://arxiv.org/html/2408.02722v3#Thmtheorem6"}, {"ref": "Thm 4", "url": "https://arxiv.org/html/2408.02722v3#Thmtheorem4"}]}, "statement": "Under the three conditions, for every fixed $\\epsilon\\in[0,1)$, the upper limit of $h_n^\\epsilon$ is at most $D^{\\mathrm{reg}}(\\rho\\Vert F)$. The case $\\epsilon=0$ is included.", "book": "Strong converse upper bound: upper bound on the upper limit of the testing rate including ε=0 [the strong converse side of the proof of H–Y Theorem 4; a consequence of optimizing the fixed-block estimate of Lemma 6]", "original": {"gour": "\\begin{myt}{\\color{yellow} The Generalized Quantum Stein's Lemma}\n\\begin{theorem}\\label{gsl}\nLet $\\mf$ be a QRT whose sets of free states satisfy the properties above.\nThen, for all $\\eps\\in(0,1)$ and all $\\rho\\in\\md(A)$\n\\be\\label{1158}\n\\lim_{n\\to\\infty}\\frac{1}{n}D_{\\min}^{\\eps}\\left(\\rho^{\\otimes n}\\big\\|\\mf\\right)=D^{\\reg}(\\rho\\|\\mf)\\;.\n\\ee\n\\end{theorem}", "hy": "\\begin{lemma}\\label{L5}\nGiven any fixed positive integer $m$, any state $\\rho$ of $\\mathcal{H}$, and any state $\\sigma_m\\in\\mathcal{S}^{(m)}$, and any full-rank state $\\sigma_\\mathrm{full}\\in\\mathcal{S}^{(1)}$,\nfor each $n\\in\\{1,2,\\ldots\\}$ and $l\\in\\{0,1,\\ldots\\}$ satisfying $lm\\leq n< (l+1)m$, we define\n\\begin{align}\n\\label{eq:tilde_sigma_n}\n\\tilde{\\sigma}_{n}&\\coloneqq\n\\sigma_{m}^{\\otimes l}\n\\otimes \\sigma_\\mathrm{full}^{\\otimes (n- lm)}.\n\\end{align}\nFor any $\\epsilon\\in[0,1)$, we have\n\\begin{align}\n&\\limsup_{n \\to \\infty}-\\frac{1}{n}\\log\n\\beta_{\\epsilon} \\left(\\rho^{\\otimes n} \\middle\\| \\tilde{\\sigma}_{n}\\right) \n\\leq\\frac{1}{m}D \\left(\\rho^{\\otimes m}\\middle\\| \\sigma_{m}\\right).\n\\end{align}\n\\end{lemma}\n"}, "signature_sha256": "5772233cc61b9f156c436aa07f36792ecafcdb926fb49e4df2f9a2444298e28c", "display": {"section": "hy", "statement": "Under the three conditions, for every fixed $\\epsilon\\in[0,1)$, the upper limit of $h_n^\\epsilon$ is at most $D^{\\mathrm{reg}}(\\rho\\Vert F)$. The case $\\epsilon=0$ is included."}, "numbered_source": false}
