import Quantum.QuantumModel.TensorCalculus.GSLCore

/-!
# Structural channels

The coherence maps of the product-dimension skeleton are conjugations by the
canonical reindexing isometries of the underlying Euclidean spaces.
-/

noncomputable section

namespace QuantumModel

open CategoryTheory
open CategoryTheory.MonoidalCategory
open QuantumState
open scoped Kronecker Matrix

variable {A B C : Sys}

/-- A singleton Kraus term bundled as an HP categorical morphism. -/
noncomputable def krausTermHom (V : Space A →ₗ[ℂ] Space B) : A ⟶ B :=
  (KrausFamily.mk PUnit inferInstance inferInstance (fun _ ↦ V)).map

@[simp]
theorem toRawSuperoperator_krausTermHom
    (V : Space A →ₗ[ℂ] Space B) :
    HPHom.toRawSuperoperator (krausTermHom V) =
      QuantumChannel.krausTerm V := by
  apply LinearMap.ext
  intro X
  simp [krausTermHom, KrausFamily.rawMap]

/-- Reindexing canonical Euclidean coordinates is a Hilbert-space isometry. -/
def spaceReindexEquiv {A B : Sys} (e : Fin A.dim ≃ Fin B.dim) :
    Space A ≃ₗᵢ[ℂ] Space B :=
  (spaceONB A).equiv (spaceONB B) e

@[simp]
theorem spaceReindexEquiv_matrix {A B : Sys} (e : Fin A.dim ≃ Fin B.dim) :
    LinearMap.toMatrix (spaceBasis A) (spaceBasis B)
        (spaceReindexEquiv e).toLinearMap =
      fun j i => if j = e i then 1 else 0 := by
  ext j i
  rw [LinearMap.toMatrix_apply]
  change ((spaceBasis B).repr
    (((spaceONB A).equiv (spaceONB B) e) (spaceONB A i))) j = _
  rw [OrthonormalBasis.equiv_apply_basis]
  simp

theorem permutation_conjugation_matrix
    {m n : Type*} [Fintype m] [DecidableEq n]
    (e : m ≃ n) (M : Matrix m m ℂ) :
    let P : Matrix n m ℂ := fun j i => if j = e i then 1 else 0
    P * M * (P)ᴴ = M.submatrix e.symm e.symm := by
  dsimp only
  classical
  ext i j
  simp only [Matrix.mul_apply, Matrix.conjTranspose_apply,
    Matrix.submatrix_apply]
  rw [Finset.sum_eq_single (e.symm j)]
  · rw [Finset.sum_eq_single (e.symm i)]
    · simp
    · intro x _ hx
      have hne : i ≠ e x := by
        intro hix
        apply hx
        have := congrArg e.symm hix
        simpa using this.symm
      simp [hne]
    · simp
  · intro x _ hx
    have hne : j ≠ e x := by
      intro hjx
      apply hx
      have := congrArg e.symm hjx
      simpa using this.symm
    simp [hne]
  · simp

/-- A singleton Kraus family generated by an isometry is a channel. -/
theorem isChannel_krausTerm_isometry
    (U : Space A ≃ₗᵢ[ℂ] Space B) :
    IsChannel (krausTermHom U.toLinearMap) := by
  let K : KrausFamily A B :=
    { index := PUnit
      fintypeIndex := inferInstance
      decidableEqIndex := inferInstance
      operator := fun _ => U.toLinearMap }
  have hKmap : K.map = krausTermHom U.toLinearMap := by
    apply HPHom.ext
    intro X
    rw [KrausFamily.map_toRawSuperoperator,
      toRawSuperoperator_krausTermHom]
    change K.rawMap X = QuantumChannel.krausTerm U.toLinearMap X
    simp [KrausFamily.rawMap, K]
  refine ⟨?_, K, hKmap, ?_⟩
  · rw [← hKmap]
    exact K.map_isCompletelyPositive
  · simp only [KrausFamily.normalization, K, Finset.univ_unique,
      Finset.sum_singleton]
    rw [U.adjoint_toLinearMap_eq_symm]
    apply LinearMap.ext
    intro x
    exact congrFun U.symm_comp_self x

theorem krausTerm_isometry_comp_symm
    (U : Space A ≃ₗᵢ[ℂ] Space B) :
    (QuantumChannel.krausTerm U.symm.toLinearMap).comp
      (QuantumChannel.krausTerm U.toLinearMap) =
      (LinearMap.id : RawSuperoperator A A) := by
  apply LinearMap.ext
  intro X
  simp only [QuantumChannel.krausTerm, LinearMap.comp_apply]
  simp only [U.adjoint_toLinearMap_eq_symm,
    U.symm.adjoint_toLinearMap_eq_symm]
  apply LinearMap.ext
  intro x
  simp

theorem krausTermHom_isometry_comp_symm
    (U : Space A ≃ₗᵢ[ℂ] Space B) :
    krausTermHom U.toLinearMap ≫ krausTermHom U.symm.toLinearMap = 𝟙 A := by
  apply HPHom.ext
  intro X
  change (HPHom.toRawSuperoperator (krausTermHom U.symm.toLinearMap)).comp
      (HPHom.toRawSuperoperator (krausTermHom U.toLinearMap)) X = X
  rw [toRawSuperoperator_krausTermHom,
    toRawSuperoperator_krausTermHom]
  exact LinearMap.congr_fun (krausTerm_isometry_comp_symm U) X

def leftUnitorIndexEquiv (A : Sys) :
    Fin (tensorSystem tensorUnitSystem A).dim ≃ Fin A.dim :=
  finCongr (Nat.one_mul A.dim)

def rightUnitorIndexEquiv (A : Sys) :
    Fin (tensorSystem A tensorUnitSystem).dim ≃ Fin A.dim :=
  finCongr (Nat.mul_one A.dim)

def associatorIndexEquiv (A B C : Sys) :
    Fin (tensorSystem (tensorSystem A B) C).dim ≃
      Fin (tensorSystem A (tensorSystem B C)).dim :=
  ((finProdFinEquiv.symm :
      Fin ((A.dim * B.dim) * C.dim) ≃ Fin (A.dim * B.dim) × Fin C.dim).trans
    ((finProdFinEquiv.symm : Fin (A.dim * B.dim) ≃
      Fin A.dim × Fin B.dim).prodCongr (Equiv.refl _))).trans
    (Equiv.prodAssoc (Fin A.dim) (Fin B.dim) (Fin C.dim)) |>.trans
    ((Equiv.refl _).prodCongr
      (finProdFinEquiv : Fin B.dim × Fin C.dim ≃ Fin (B.dim * C.dim))) |>.trans
    (finProdFinEquiv :
      Fin A.dim × Fin (B.dim * C.dim) ≃ Fin (A.dim * (B.dim * C.dim)))

theorem leftUnitor_hom_eq_krausTerm (A : Sys) :
    (λ_ A).hom = krausTermHom
      (spaceReindexEquiv (leftUnitorIndexEquiv A)).toLinearMap := by
  apply HPHom.ext
  intro X
  change HPHom.toRawSuperoperator (leftUnitorIso A).hom X =
    HPHom.toRawSuperoperator
      (krausTermHom
        (spaceReindexEquiv (leftUnitorIndexEquiv A)).toLinearMap) X
  rw [toRawSuperoperator_krausTermHom]
  change leftUnitorLinearEquiv A X =
    QuantumChannel.krausTerm
      (spaceReindexEquiv (leftUnitorIndexEquiv A)).toLinearMap X
  change (TensorProduct.lid ℂ (Operator A))
      (TensorProduct.map operatorUnitEquiv.symm.toLinearMap LinearMap.id
        ((operatorTensorEquiv tensorUnitSystem A).symm X)) = _
  let Z := (operatorTensorEquiv tensorUnitSystem A).symm X
  have hZ : operatorTensorEquiv tensorUnitSystem A Z = X := by
    simp [Z]
  rw [← hZ]
  induction Z using TensorProduct.induction_on with
  | zero => simp [QuantumChannel.krausTerm]
  | tmul S Y =>
      simp only [LinearEquiv.symm_apply_apply, TensorProduct.map_tmul,
        LinearMap.id_apply, TensorProduct.lid_tmul]
      apply (operatorEquivMatrix A).injective
      change operatorEquivMatrix A
          ((operatorUnitEquiv.symm S) • Y) =
        operatorEquivMatrix A
          (QuantumChannel.krausTerm
            (spaceReindexEquiv (leftUnitorIndexEquiv A)).toLinearMap
            (operatorTensorEquiv tensorUnitSystem A (S ⊗ₜ[ℂ] Y)))
      rw [operatorEquivMatrix_krausTerm,
        spaceReindexEquiv_matrix, operatorTensorEquiv_matrix_tmul]
      rw [permutation_conjugation_matrix]
      ext i j
      let zeroUnit : Fin tensorUnitSystem.dim :=
        ⟨0, tensorUnitSystem.dim_pos⟩
      have hscalar : operatorUnitEquiv.symm S =
          operatorEquivMatrix tensorUnitSystem S zeroUnit zeroUnit := by
        rfl
      rw [hscalar]
      have hpair (k : Fin A.dim) :
          finProdFinEquiv.symm ((leftUnitorIndexEquiv A).symm k) =
            (zeroUnit, k) := by
        apply Prod.ext
        · apply Fin.ext
          simp [zeroUnit, leftUnitorIndexEquiv, Fin.divNat,
            Nat.div_eq_of_lt k.isLt]
        · apply Fin.ext
          simp [leftUnitorIndexEquiv, Fin.modNat,
            Nat.mod_eq_of_lt k.isLt]
      change operatorEquivMatrix tensorUnitSystem S zeroUnit zeroUnit *
          operatorEquivMatrix A Y i j =
        (operatorEquivMatrix tensorUnitSystem S ⊗ₖ
          operatorEquivMatrix A Y)
          (finProdFinEquiv.symm ((leftUnitorIndexEquiv A).symm i))
          (finProdFinEquiv.symm ((leftUnitorIndexEquiv A).symm j))
      rw [hpair i, hpair j]
      rfl
  | add Z W hZ hW =>
      simpa only [LinearEquiv.symm_apply_apply, map_add] using
        congrArg₂ (fun P Q : Operator A => P + Q) hZ hW

theorem leftUnitor_inv_eq_krausTerm (A : Sys) :
    (λ_ A).inv = krausTermHom
      (spaceReindexEquiv (leftUnitorIndexEquiv A)).symm.toLinearMap := by
  apply (cancel_epi (λ_ A).hom).mp
  rw [Iso.hom_inv_id]
  rw [leftUnitor_hom_eq_krausTerm]
  exact (krausTermHom_isometry_comp_symm
    (spaceReindexEquiv (leftUnitorIndexEquiv A))).symm

theorem leftUnitor_hom_isChannel (A : Sys) : IsChannel (λ_ A).hom := by
  rw [leftUnitor_hom_eq_krausTerm]
  exact isChannel_krausTerm_isometry _

theorem leftUnitor_inv_isChannel (A : Sys) : IsChannel (λ_ A).inv := by
  rw [leftUnitor_inv_eq_krausTerm]
  exact isChannel_krausTerm_isometry _

theorem rightUnitor_hom_eq_krausTerm (A : Sys) :
    (ρ_ A).hom = krausTermHom
      (spaceReindexEquiv (rightUnitorIndexEquiv A)).toLinearMap := by
  apply HPHom.ext
  intro X
  change HPHom.toRawSuperoperator (rightUnitorIso A).hom X =
    HPHom.toRawSuperoperator
      (krausTermHom
        (spaceReindexEquiv (rightUnitorIndexEquiv A)).toLinearMap) X
  rw [toRawSuperoperator_krausTermHom]
  change rightUnitorLinearEquiv A X =
    QuantumChannel.krausTerm
      (spaceReindexEquiv (rightUnitorIndexEquiv A)).toLinearMap X
  change (TensorProduct.rid ℂ (Operator A))
      (TensorProduct.map LinearMap.id operatorUnitEquiv.symm.toLinearMap
        ((operatorTensorEquiv A tensorUnitSystem).symm X)) = _
  let Z := (operatorTensorEquiv A tensorUnitSystem).symm X
  have hZ : operatorTensorEquiv A tensorUnitSystem Z = X := by
    simp [Z]
  rw [← hZ]
  induction Z using TensorProduct.induction_on with
  | zero => simp [QuantumChannel.krausTerm]
  | tmul Y S =>
      simp only [LinearEquiv.symm_apply_apply, TensorProduct.map_tmul,
        LinearMap.id_apply, TensorProduct.rid_tmul]
      apply (operatorEquivMatrix A).injective
      change operatorEquivMatrix A
          ((operatorUnitEquiv.symm S) • Y) =
        operatorEquivMatrix A
          (QuantumChannel.krausTerm
            (spaceReindexEquiv (rightUnitorIndexEquiv A)).toLinearMap
            (operatorTensorEquiv A tensorUnitSystem (Y ⊗ₜ[ℂ] S)))
      rw [operatorEquivMatrix_krausTerm,
        spaceReindexEquiv_matrix, operatorTensorEquiv_matrix_tmul]
      rw [permutation_conjugation_matrix]
      ext i j
      let zeroUnit : Fin tensorUnitSystem.dim :=
        ⟨0, tensorUnitSystem.dim_pos⟩
      have hscalar : operatorUnitEquiv.symm S =
          operatorEquivMatrix tensorUnitSystem S zeroUnit zeroUnit := by
        rfl
      rw [hscalar]
      have hpair (k : Fin A.dim) :
          finProdFinEquiv.symm ((rightUnitorIndexEquiv A).symm k) =
            (k, zeroUnit) := by
        apply Prod.ext
        · apply Fin.ext
          change ((rightUnitorIndexEquiv A).symm k).val /
              tensorUnitSystem.dim = k.val
          simp [rightUnitorIndexEquiv, tensorUnitSystem]
          rfl
        · apply Fin.ext
          change ((rightUnitorIndexEquiv A).symm k).val %
              tensorUnitSystem.dim = zeroUnit.val
          simp only [tensorUnitSystem, rightUnitorIndexEquiv, finCongr_symm, zeroUnit]
          rw [Nat.mod_one]
      change operatorEquivMatrix tensorUnitSystem S zeroUnit zeroUnit *
          operatorEquivMatrix A Y i j =
        (operatorEquivMatrix A Y ⊗ₖ
          operatorEquivMatrix tensorUnitSystem S)
          (finProdFinEquiv.symm ((rightUnitorIndexEquiv A).symm i))
          (finProdFinEquiv.symm ((rightUnitorIndexEquiv A).symm j))
      rw [hpair i, hpair j]
      exact mul_comm _ _
  | add Z W hZ hW =>
      simpa only [LinearEquiv.symm_apply_apply, map_add] using
        congrArg₂ (fun P Q : Operator A => P + Q) hZ hW

theorem rightUnitor_inv_eq_krausTerm (A : Sys) :
    (ρ_ A).inv = krausTermHom
      (spaceReindexEquiv (rightUnitorIndexEquiv A)).symm.toLinearMap := by
  apply (cancel_epi (ρ_ A).hom).mp
  rw [Iso.hom_inv_id]
  rw [rightUnitor_hom_eq_krausTerm]
  exact (krausTermHom_isometry_comp_symm
    (spaceReindexEquiv (rightUnitorIndexEquiv A))).symm

theorem rightUnitor_hom_isChannel (A : Sys) : IsChannel (ρ_ A).hom := by
  rw [rightUnitor_hom_eq_krausTerm]
  exact isChannel_krausTerm_isometry _

theorem rightUnitor_inv_isChannel (A : Sys) : IsChannel (ρ_ A).inv := by
  rw [rightUnitor_inv_eq_krausTerm]
  exact isChannel_krausTerm_isometry _

/-- The associator reindexing sends the left-nested coordinate `((p, q), r)` to the
right-nested coordinate `(p, (q, r))`. -/
private theorem associatorIndexEquiv_apply_finProdFin (A B C : Sys)
    (p : Fin A.dim) (q : Fin B.dim) (r : Fin C.dim) :
    associatorIndexEquiv A B C
        (finProdFinEquiv (m := (tensorSystem A B).dim) (n := C.dim)
          (finProdFinEquiv (m := A.dim) (n := B.dim) (p, q), r)) =
      finProdFinEquiv (m := A.dim) (n := (tensorSystem B C).dim)
        (p, finProdFinEquiv (m := B.dim) (n := C.dim) (q, r)) := by
  change (((((finProdFinEquiv.symm :
      Fin ((A.dim * B.dim) * C.dim) ≃ Fin (A.dim * B.dim) × Fin C.dim).trans
    ((finProdFinEquiv.symm : Fin (A.dim * B.dim) ≃
      Fin A.dim × Fin B.dim).prodCongr (Equiv.refl _))).trans
    (Equiv.prodAssoc (Fin A.dim) (Fin B.dim) (Fin C.dim))).trans
    ((Equiv.refl _).prodCongr
      (finProdFinEquiv : Fin B.dim × Fin C.dim ≃ Fin (B.dim * C.dim)))).trans
    (finProdFinEquiv :
      Fin A.dim × Fin (B.dim * C.dim) ≃ Fin (A.dim * (B.dim * C.dim))))
      (finProdFinEquiv (finProdFinEquiv (p, q), r)) =
    finProdFinEquiv (p, finProdFinEquiv (q, r))
  simp only [Equiv.trans_apply, Equiv.symm_apply_apply, Equiv.prodCongr_apply,
    Prod.map_apply, Equiv.refl_apply, Equiv.prodAssoc_apply]

/-- Matrix form of the associator: re-nesting a triple Kronecker product is the
conjugation by the associator reindexing. -/
private theorem associator_kronecker_matrix (A B C : Sys)
    (X : Matrix (Fin A.dim) (Fin A.dim) ℂ) (Y : Matrix (Fin B.dim) (Fin B.dim) ℂ)
    (Z : Matrix (Fin C.dim) (Fin C.dim) ℂ) :
    (Matrix.reindexLinearEquiv ℂ ℂ finProdFinEquiv finProdFinEquiv
        (X ⊗ₖ Matrix.reindexLinearEquiv ℂ ℂ finProdFinEquiv finProdFinEquiv (Y ⊗ₖ Z)) :
        Matrix (Fin (tensorSystem A (tensorSystem B C)).dim)
          (Fin (tensorSystem A (tensorSystem B C)).dim) ℂ) =
      (Matrix.reindexLinearEquiv ℂ ℂ finProdFinEquiv finProdFinEquiv
          (Matrix.reindexLinearEquiv ℂ ℂ finProdFinEquiv finProdFinEquiv (X ⊗ₖ Y) ⊗ₖ Z) :
          Matrix (Fin (tensorSystem (tensorSystem A B) C).dim)
            (Fin (tensorSystem (tensorSystem A B) C).dim) ℂ).submatrix
        (associatorIndexEquiv A B C).symm (associatorIndexEquiv A B C).symm := by
  ext i j
  obtain ⟨x, rfl⟩ := (associatorIndexEquiv A B C).surjective i
  obtain ⟨y, rfl⟩ := (associatorIndexEquiv A B C).surjective j
  obtain ⟨⟨u, r⟩, rfl⟩ :=
    (finProdFinEquiv (m := (tensorSystem A B).dim) (n := C.dim)).surjective x
  obtain ⟨⟨p, q⟩, rfl⟩ := (finProdFinEquiv (m := A.dim) (n := B.dim)).surjective u
  obtain ⟨⟨u', r'⟩, rfl⟩ :=
    (finProdFinEquiv (m := (tensorSystem A B).dim) (n := C.dim)).surjective y
  obtain ⟨⟨p', q'⟩, rfl⟩ := (finProdFinEquiv (m := A.dim) (n := B.dim)).surjective u'
  simp only [Matrix.submatrix_apply, Equiv.symm_apply_apply]
  rw [associatorIndexEquiv_apply_finProdFin, associatorIndexEquiv_apply_finProdFin]
  simp only [Matrix.submatrix_apply, Equiv.symm_apply_apply,
    Matrix.reindexLinearEquiv_apply, Matrix.reindex_apply, Matrix.kronecker_apply]
  ring

theorem associator_hom_eq_krausTerm (A B C : Sys) :
    (α_ A B C).hom = krausTermHom
      (spaceReindexEquiv (associatorIndexEquiv A B C)).toLinearMap := by
  apply HPHom.ext
  intro X
  change HPHom.toRawSuperoperator (associatorIso A B C).hom X =
    HPHom.toRawSuperoperator
      (krausTermHom
        (spaceReindexEquiv (associatorIndexEquiv A B C)).toLinearMap) X
  rw [toRawSuperoperator_krausTermHom]
  change associatorLinearEquiv A B C X =
    QuantumChannel.krausTerm
      (spaceReindexEquiv (associatorIndexEquiv A B C)).toLinearMap X
  -- Both sides are linear in `X`; compare them on the left-nested product tensors.
  let E : TensorProduct ℂ (TensorProduct ℂ (Operator A) (Operator B)) (Operator C) ≃ₗ[ℂ]
      Operator (tensorSystem (tensorSystem A B) C) :=
    (TensorProduct.congr (operatorTensorEquiv A B)
      (LinearEquiv.refl ℂ (Operator C))).trans
      (operatorTensorEquiv (tensorSystem A B) C)
  have hcomp :
      (associatorLinearEquiv A B C).toLinearMap ∘ₗ E.toLinearMap =
        QuantumChannel.krausTerm
          (spaceReindexEquiv (associatorIndexEquiv A B C)).toLinearMap ∘ₗ
          E.toLinearMap := by
    refine TensorProduct.ext_threefold fun XA YB ZC => ?_
    have hE : E ((XA ⊗ₜ[ℂ] YB) ⊗ₜ[ℂ] ZC) =
        operatorTensorEquiv (tensorSystem A B) C
          (operatorTensorEquiv A B (XA ⊗ₜ[ℂ] YB) ⊗ₜ[ℂ] ZC) := rfl
    have hassoc : associatorLinearEquiv A B C
        (operatorTensorEquiv (tensorSystem A B) C
          (operatorTensorEquiv A B (XA ⊗ₜ[ℂ] YB) ⊗ₜ[ℂ] ZC)) =
        operatorTensorEquiv A (tensorSystem B C)
          (XA ⊗ₜ[ℂ] operatorTensorEquiv B C (YB ⊗ₜ[ℂ] ZC)) := by
      delta associatorLinearEquiv
      simp only [LinearEquiv.trans_apply,
        LinearEquiv.symm_apply_apply, TensorProduct.congr_tmul,
        LinearEquiv.refl_apply, TensorProduct.assoc_tmul]
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
      LinearEquiv.coe_coe, hE, hassoc]
    apply EquivLike.injective (operatorEquivMatrix (tensorSystem A (tensorSystem B C)))
    rw [operatorEquivMatrix_krausTerm, spaceReindexEquiv_matrix,
      operatorTensorEquiv_matrix_tmul, operatorTensorEquiv_matrix_tmul,
      operatorTensorEquiv_matrix_tmul, operatorTensorEquiv_matrix_tmul,
      permutation_conjugation_matrix]
    exact associator_kronecker_matrix A B C _ _ _
  simpa [E] using LinearMap.congr_fun hcomp (E.symm X)

theorem associator_inv_eq_krausTerm (A B C : Sys) :
    (α_ A B C).inv = krausTermHom
      (spaceReindexEquiv (associatorIndexEquiv A B C)).symm.toLinearMap := by
  apply (cancel_epi (α_ A B C).hom).mp
  rw [Iso.hom_inv_id]
  rw [associator_hom_eq_krausTerm]
  exact (krausTermHom_isometry_comp_symm
    (spaceReindexEquiv (associatorIndexEquiv A B C))).symm

theorem associator_hom_isChannel (A B C : Sys) : IsChannel (α_ A B C).hom := by
  rw [associator_hom_eq_krausTerm]
  exact isChannel_krausTerm_isometry _

theorem associator_inv_isChannel (A B C : Sys) : IsChannel (α_ A B C).inv := by
  rw [associator_inv_eq_krausTerm]
  exact isChannel_krausTerm_isometry _

end QuantumModel
