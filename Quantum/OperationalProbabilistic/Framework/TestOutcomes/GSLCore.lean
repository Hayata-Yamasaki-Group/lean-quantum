import Quantum.OperationalProbabilistic.Framework.TestsCore.GSLCore

open CategoryTheory
open scoped MonoidalCategory

/-!
# Operational framework: effect and transformation quotients, tests

Operational equivalence of effects and of transformations is quotiented into
`OperationalEffectSpaceReal` and `OperationalTransformationSpaceReal`.  The test data
structures `IndexedTest`, `Test`, `ObservationTest` and `BinaryObservationTest` are defined,
together with the effect order `LeEffect` and the tensor effect `tensorEffect`.

Related source: CDP (arXiv:1011.6451).
-/

namespace OPT

universe u v w

section OperationalProbabilisticTheory

variable {Sys : Type u} [Category.{v} Sys] [MonoidalCategory Sys]

variable [Preadditive Sys]

variable [CategoryTheory.Linear ℝ Sys] [MonoidalPreadditive Sys] [MonoidalLinear ℝ Sys]

variable [OperationalProbabilisticTheory Sys]

/-- Operational effect equivalence is exactly membership of the difference in the null subspace. -/
private theorem effectOperationalEquiv_iff_sub_mem_null {A : Sys} {a b : Effect A} :
    EffectOperationalEquiv a b ↔
      a - b ∈ EffectOperationalNullSubmodule (Sys := Sys) A := by
  constructor
  · intro h ρ hρ
    have hsub :
        prob (a - b) ρ = prob a ρ - prob b ρ := by
      exact map_sub (effectEvalLinearMap (Sys := Sys) (A := A) ρ) a b
    rw [hsub, h ρ hρ, sub_self]
  · intro h ρ hρ
    have hsub :
        prob (a - b) ρ = prob a ρ - prob b ρ := by
      exact map_sub (effectEvalLinearMap (Sys := Sys) (A := A) ρ) a b
    have hzero : prob a ρ - prob b ρ = 0 := by
      simpa [hsub] using h ρ hρ
    exact sub_eq_zero.mp hzero

/-- Operational effect equivalence is equality in the quotient space. -/
theorem effectOperationalEquiv_iff_class_eq {A : Sys} {a b : Effect A} :
    EffectOperationalEquiv a b ↔
      effectOperationalClass (Sys := Sys) A a =
        effectOperationalClass (Sys := Sys) A b := by
  rw [effectOperationalEquiv_iff_sub_mem_null]
  change
    a - b ∈ EffectOperationalNullSubmodule (Sys := Sys) A ↔
      Submodule.Quotient.mk a = Submodule.Quotient.mk b
  exact (Submodule.Quotient.eq (EffectOperationalNullSubmodule (Sys := Sys) A)).symm

/-- A presentation in which operationally equivalent raw effects are equal.

This mirrors `StateRawExtensionalityTheory` on the effect side.  It is a
presentation interface: it reflects equality in the operational effect quotient
back to equality of the chosen raw effect representatives. -/
class EffectRawExtensionalityTheory (Sys : Type u) [Category.{v} Sys] [MonoidalCategory Sys]
    [Preadditive Sys]
    [CategoryTheory.Linear ℝ Sys] [MonoidalPreadditive Sys] [MonoidalLinear ℝ Sys]
    [OperationalProbabilisticTheory Sys] : Prop where
  effect_eq_of_operationalClass_eq :
    ∀ {A : Sys} {a b : Effect A},
      effectOperationalClass (Sys := Sys) A a =
        effectOperationalClass (Sys := Sys) A b →
      a = b

/-- Reflect equality of operational effect classes back to raw effect equality. -/
theorem effect_eq_of_operationalClass_eq [EffectRawExtensionalityTheory Sys]
    {A : Sys} {a b : Effect A}
    (hclass :
      effectOperationalClass (Sys := Sys) A a =
        effectOperationalClass (Sys := Sys) A b) :
    a = b :=
  EffectRawExtensionalityTheory.effect_eq_of_operationalClass_eq (Sys := Sys) hclass

/-- Equivalence classes represented by physical effects. -/
noncomputable def PhysicalEffectClassSet (A : Sys) :
    Set (EffectOperationalQuotient (Sys := Sys) A) :=
  {x | ∃ a : Effect A, IsEffect a ∧ effectOperationalClass (Sys := Sys) A a = x}

/-- The real vector space generated by physical effects after operational quotienting. -/
noncomputable def OperationalEffectSpaceRealSubmodule (A : Sys) :
    Submodule ℝ (EffectOperationalQuotient (Sys := Sys) A) :=
  Submodule.span ℝ (PhysicalEffectClassSet (Sys := Sys) A)

/-- Operational real effect space: the span of physical effect classes in the quotient. -/
abbrev OperationalEffectSpaceReal (A : Sys) : Type v :=
  OperationalEffectSpaceRealSubmodule (Sys := Sys) A

/-- A physical effect class belongs to the operational real effect space. -/
theorem effectClass_mem_OperationalEffectSpaceRealSubmodule {A : Sys} {a : Effect A}
    (ha : IsEffect a) :
    effectOperationalClass (Sys := Sys) A a ∈
      OperationalEffectSpaceRealSubmodule (Sys := Sys) A :=
  Submodule.subset_span ⟨a, ha, rfl⟩

/-- Evaluation of a transformation candidate by a fixed ancillary state/effect test is
real-linear. -/
noncomputable def transformationEvalLinearMap {A B R : Sys}
    (ρ : State (A ⊗ R)) (e : Effect (B ⊗ R)) : (A ⟶ B) →ₗ[ℝ] ℝ where
  toFun := fun f => prob e (ρ ≫ (f ⊗ₘ 𝟙 R))
  map_add' := by
    intro f g
    unfold prob
    rw [OperationalProbabilisticTheory.tensor_add_left]
    rw [OperationalProbabilisticTheory.comp_add]
    rw [OperationalProbabilisticTheory.add_comp]
    exact map_add (scalarEval (Sys := Sys)) ((ρ ≫ (f ⊗ₘ 𝟙 R)) ≫ e)
      ((ρ ≫ (g ⊗ₘ 𝟙 R)) ≫ e)
  map_smul' := by
    intro r f
    unfold prob
    rw [OperationalProbabilisticTheory.tensor_smul_left]
    rw [OperationalProbabilisticTheory.comp_smul]
    rw [OperationalProbabilisticTheory.smul_comp]
    exact map_smul (scalarEval (Sys := Sys)) r ((ρ ≫ (f ⊗ₘ 𝟙 R)) ≫ e)

/-- Null subspace of transformation candidates that no ancillary state/effect experiment can
distinguish from zero. -/
noncomputable def TransformationOperationalNullSubmodule (A B : Sys) :
    Submodule ℝ (A ⟶ B) where
  carrier := {δ | ∀ (R : Sys) (ρ : State (A ⊗ R)) (e : Effect (B ⊗ R)),
    IsState ρ → IsEffect e → prob e (ρ ≫ (δ ⊗ₘ 𝟙 R)) = 0}
  zero_mem' := by
    intro R ρ e _hρ _he
    exact map_zero (transformationEvalLinearMap (Sys := Sys) (A := A) (B := B) ρ e)
  add_mem' := by
    intro δ ε hδ hε R ρ e hρ he
    calc
      prob e (ρ ≫ ((δ + ε) ⊗ₘ 𝟙 R)) =
          prob e (ρ ≫ (δ ⊗ₘ 𝟙 R)) + prob e (ρ ≫ (ε ⊗ₘ 𝟙 R)) := by
            exact map_add
              (transformationEvalLinearMap (Sys := Sys) (A := A) (B := B) ρ e) δ ε
      _ = 0 := by rw [hδ R ρ e hρ he, hε R ρ e hρ he, add_zero]
  smul_mem' := by
    intro r δ hδ R ρ e hρ he
    calc
      prob e (ρ ≫ ((r • δ) ⊗ₘ 𝟙 R)) =
          r • prob e (ρ ≫ (δ ⊗ₘ 𝟙 R)) := by
            exact map_smul
              (transformationEvalLinearMap (Sys := Sys) (A := A) (B := B) ρ e) r δ
      _ = 0 := by rw [hδ R ρ e hρ he, smul_zero]

/-- Quotient of transformation candidates by operational equivalence. -/
abbrev TransformationOperationalQuotient (A B : Sys) : Type v :=
  (A ⟶ B) ⧸ TransformationOperationalNullSubmodule (Sys := Sys) A B

/-- Canonical map from transformation candidates to operational transformation classes. -/
noncomputable def transformationOperationalClass (A B : Sys) :
    (A ⟶ B) →ₗ[ℝ] TransformationOperationalQuotient (Sys := Sys) A B :=
  (TransformationOperationalNullSubmodule (Sys := Sys) A B).mkQ

/-- Equivalence classes represented by physical transformations. -/
noncomputable def PhysicalTransformationClassSet (A B : Sys) :
    Set (TransformationOperationalQuotient (Sys := Sys) A B) :=
  {x | ∃ f : A ⟶ B, IsTransformation f ∧
    transformationOperationalClass (Sys := Sys) A B f = x}

/-- The real vector space generated by physical transformation classes after operational
quotienting. -/
noncomputable def OperationalTransformationSpaceRealSubmodule (A B : Sys) :
    Submodule ℝ (TransformationOperationalQuotient (Sys := Sys) A B) :=
  Submodule.span ℝ (PhysicalTransformationClassSet (Sys := Sys) A B)

/-- Operational real transformation space: the span of physical transformation classes in the
quotient. -/
abbrev OperationalTransformationSpaceReal (A B : Sys) : Type v :=
  OperationalTransformationSpaceRealSubmodule (Sys := Sys) A B

/-- A physical transformation class belongs to the operational real transformation space. -/
theorem transformationClass_mem_OperationalTransformationSpaceRealSubmodule
    {A B : Sys} {f : A ⟶ B} (hf : IsTransformation f) :
    transformationOperationalClass (Sys := Sys) A B f ∈
      OperationalTransformationSpaceRealSubmodule (Sys := Sys) A B :=
  Submodule.subset_span ⟨f, hf, rfl⟩

/-- Operational real transformation class represented by a physical transformation. -/
noncomputable def operationalTransformationClass
    {A B : Sys} (f : A ⟶ B) (hf : IsTransformation f) :
    OperationalTransformationSpaceReal (Sys := Sys) A B :=
  ⟨transformationOperationalClass (Sys := Sys) A B f,
    transformationClass_mem_OperationalTransformationSpaceRealSubmodule (Sys := Sys) hf⟩

/-- CDP effect order: pointwise probability order on all physical states. -/
def LeEffect {A : Sys} (a b : Effect A) : Prop :=
  ∀ ρ : State A, IsState ρ → prob a ρ ≤ prob b ρ

/-- Tensor product of effects, transported along the monoidal left unitor of the unit. -/
noncomputable def tensorEffect {A B : Sys} (a : Effect A) (b : Effect B) :
    Effect (A ⊗ B) :=
  (a ⊗ₘ b) ≫ (λ_ (𝟙_ Sys)).hom

/-- Finite outcome tests with the result type kept explicit. -/
@[ext]
structure IndexedTest (A B : Sys) (ι : Type) [Fintype ι] where
  outcome : ι → (A ⟶ B)
  isTest : IsTest outcome

/-- Finite outcome tests, with the finite result type bundled as part of the data. -/
@[ext]
structure Test (A B : Sys) where
  ι : Type
  [fintype : Fintype ι]
  outcome : ι → (A ⟶ B)
  isTest : IsTest outcome

attribute [instance] Test.fintype

namespace Test

/-- Bundle an explicitly indexed finite test. -/
def ofIndexed {A B : Sys} {ι : Type} [Fintype ι]
    (E : IndexedTest A B ι) : Test A B where
  ι := ι
  outcome := E.outcome
  isTest := E.isTest

end Test

/-- Finite observation tests, i.e. tests from a system to the monoidal unit. -/
abbrev ObservationTest (A : Sys) (ι : Type) [Fintype ι] : Type _ :=
  IndexedTest A (𝟙_ Sys) ι


/-- Universe-lifted two-element outcome type for binary observation tests. -/
abbrev BinaryObservationIndex : Type :=
  (Fin 2)

namespace BinaryObservationIndex

/-- The first outcome of a binary observation test. -/
def zero : BinaryObservationIndex :=
  0

/-- The second outcome of a binary observation test. -/
def one : BinaryObservationIndex :=
  1

end BinaryObservationIndex

/-- Sums over the binary observation index split into the two summands. -/
theorem sum_binaryObservationIndex {β : Type v} [AddCommMonoid β]
    (f : BinaryObservationIndex → β) :
    Finset.univ.sum f =
      f BinaryObservationIndex.zero + f BinaryObservationIndex.one := by
  simp [BinaryObservationIndex.zero, BinaryObservationIndex.one, Fin.sum_univ_two]

/-- Outcome relabeling sending a distinguished index to the `one` outcome and every other index to
`zero`.
-/
private noncomputable def binaryObservationChoiceAsOne {ι : Type}
    (i0 : ι) (i : ι) : BinaryObservationIndex := by
  classical
  exact if i = i0 then BinaryObservationIndex.one else BinaryObservationIndex.zero

/-- Outcome relabeling sending a distinguished index to the `zero` outcome and every other index to
`one`.
-/
private noncomputable def binaryObservationChoiceAsZero {ι : Type}
    (i0 : ι) (i : ι) : BinaryObservationIndex := by
  classical
  exact if i = i0 then BinaryObservationIndex.zero else BinaryObservationIndex.one

/-- Two-outcome observation tests.  The order of the two outcomes matters in
the signed binary-evaluation formulas from ref. 21. -/
abbrev BinaryObservationTest (A : Sys) : Type _ :=
  ObservationTest A BinaryObservationIndex

/-- Each outcome of a binary observation test is a physical effect. -/
theorem binaryObservation_outcome_isEffect {A : Sys}
    (M : BinaryObservationTest (Sys := Sys) A) (i : BinaryObservationIndex) :
    IsEffect (M.outcome i) :=
  OperationalProbabilisticTheory.test_transformation (Sys := Sys)
    (A := A) (B := 𝟙_ Sys) (ι := BinaryObservationIndex) M.isTest i

/-- Every physical effect can be realized as the second outcome of a binary
observation test. -/
theorem binaryObservationTest_of_effect_as_one {A : Sys}
    (a : Effect A) (ha : IsEffect a) :
    ∃ M : BinaryObservationTest (Sys := Sys) A,
      M.outcome BinaryObservationIndex.one = a := by
  classical
  rcases OperationalProbabilisticTheory.transformation_test_outcome (Sys := Sys) ha with
    ⟨ι, hι, T, hT, i0, hi0⟩
  letI : Fintype ι := hι
  let p : ι → BinaryObservationIndex := binaryObservationChoiceAsOne i0
  let M : BinaryObservationTest (Sys := Sys) A := {
    outcome := fun k => (Finset.univ.filter (fun i : ι => p i = k)).sum T
    isTest := OperationalProbabilisticTheory.test_coarse_grain (Sys := Sys) hT p
  }
  refine ⟨M, ?_⟩
  dsimp [M, p, binaryObservationChoiceAsOne]
  rw [Finset.sum_eq_single i0]
  · simp [hi0]
  · intro b hb hne
    exfalso
    simp [hne, BinaryObservationIndex.zero, BinaryObservationIndex.one] at hb
  · intro hnot
    exfalso
    apply hnot
    simp

/-- Every physical effect can be realized as the first outcome of a binary
observation test. -/
theorem binaryObservationTest_of_effect_as_zero {A : Sys}
    (a : Effect A) (ha : IsEffect a) :
    ∃ M : BinaryObservationTest (Sys := Sys) A,
      M.outcome BinaryObservationIndex.zero = a := by
  classical
  rcases OperationalProbabilisticTheory.transformation_test_outcome (Sys := Sys) ha with
    ⟨ι, hι, T, hT, i0, hi0⟩
  letI : Fintype ι := hι
  let p : ι → BinaryObservationIndex := binaryObservationChoiceAsZero i0
  let M : BinaryObservationTest (Sys := Sys) A := {
    outcome := fun k => (Finset.univ.filter (fun i : ι => p i = k)).sum T
    isTest := OperationalProbabilisticTheory.test_coarse_grain (Sys := Sys) hT p
  }
  refine ⟨M, ?_⟩
  dsimp [M, p, binaryObservationChoiceAsZero]
  rw [Finset.sum_eq_single i0]
  · simp [hi0]
  · intro b hb hne
    exfalso
    simp [hne, BinaryObservationIndex.zero, BinaryObservationIndex.one] at hb
  · intro hnot
    exfalso
    apply hnot
    simp

/-- Signed evaluation of an operational state class by a two-outcome
observation test.  This is `(c_1 | η) - (c_0 | η)`, not the evaluation of
`c_1 - c_0` as a physical effect. -/
noncomputable def binaryObservationDiffEval {A : Sys}
    (M : BinaryObservationTest (Sys := Sys) A)
    (η : OperationalStateSpaceReal (Sys := Sys) A) : ℝ :=
  stateOperationalQuotientEval (Sys := Sys) (M.outcome BinaryObservationIndex.one)
      (binaryObservation_outcome_isEffect (Sys := Sys) M BinaryObservationIndex.one) η -
    stateOperationalQuotientEval (Sys := Sys) (M.outcome BinaryObservationIndex.zero)
      (binaryObservation_outcome_isEffect (Sys := Sys) M BinaryObservationIndex.zero) η

end OperationalProbabilisticTheory

end OPT
